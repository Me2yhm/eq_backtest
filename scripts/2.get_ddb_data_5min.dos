undef all
go

// 定义起始和结束年份
START_YEAR = 2024
// START_YEAR = 2026
END_YEAR = 2026 // 请根据实际数据年份修改此值
// END_YEAR = 2019 // 请根据实际数据年份修改此值


// 创建一个内存表作为最终结果的容器
finalResult = table(1:0, `symbol`datetime`open`close`turnover`vwap5`vwap_ret, [SYMBOL, DATETIME, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE])

// 按年循环处理
for(year in START_YEAR..END_YEAR) {
    // 定义每年1月1日和12月31日的日期

    startDate = temporalParse(string(year) + ".01.01", "yyyy.MM.dd")
    endDate = temporalParse(string(year) + ".12.31", "yyyy.MM.dd")

    // 1. 读取当年数据，利用分区剪枝优化
    bar1Min = select symbol, datetime, open, high, low, close, total_turnover, volume, date(datetime) as Date, time(datetime) as Tradetime
               from loadTable("dfs://bars_1m", "stocks_ex")
               where date(datetime) >= startDate
               and date(datetime) <= endDate

    print("Processing year: " + string(year) + ", data rows: " + string(bar1Min.size()))

    // 2. 处理 09:32-11:26 的数据（聚合为5分钟，左闭合）
    bar_0932_1126 = select * from bar1Min where Tradetime between 09:32:00.000 and 11:26:00.000
    update bar_0932_1126 set Tradetime = temporalAdd(Tradetime, -1m)
    bar_0932_1126 = select firstNot(open) as open, last(close) as close, max(high) as high, min(low) as low, sum(total_turnover) as total_turnover,
                           iif(sum(volume) > 0, sum(volume * (open+high+low+close)/4) \ sum(volume), avg((open+high+low+close)/4)) as vwap5
                    from bar_0932_1126
                    group by symbol, Date, interval(X=Tradetime, duration=5m, fill="none", closed="right", label="left") as Tradetime
    update bar_0932_1126 set Tradetime = temporalAdd(Tradetime, 1m)
    bar_0932_1126 = select symbol, concatDateTime(Date, Tradetime) as datetime, open, high, low, close, total_turnover, vwap5
                    from bar_0932_1126

    // 3. 处理 11:27-13:01 的数据（单独聚合为一条，左闭合）
    bar_1127_1301 = select symbol, datetime, open, high, low, close, total_turnover, volume, Date, Tradetime
                from bar1Min
                where Tradetime between 11:27:00.000 and 13:01:00.000
    bar_1127_1301 = select last(concatDateTime(Date, 11:26:00.000)) as datetime, firstNot(open) as open, max(high) as high, min(low) as low, last(close) as close, sum(total_turnover) as total_turnover,
                    iif(sum(volume) > 0, sum(volume * (open+high+low+close)/4) \ sum(volume), avg((open+high+low+close)/4)) as vwap5
                from bar_1127_1301
                group by symbol, Date
    bar_1127_1301 = select symbol, datetime, open, high, low, close, total_turnover, vwap5
                    from bar_1127_1301

    // 4. 处理 13:02-15:00 的数据（聚合为5分钟，左闭合）
    bar_1302_1500 = select * from bar1Min where Tradetime between 13:02:00.000 and 15:00:00.000
    update bar_1302_1500 set Tradetime = temporalAdd(Tradetime, -1m)
    bar_1302_1500 = select firstNot(open) as open, last(close) as close, max(high) as high, min(low) as low, sum(total_turnover) as total_turnover,
                           iif(sum(volume) > 0, sum(volume * (open+high+low+close)/4) \ sum(volume), avg((open+high+low+close)/4)) as vwap5
                    from bar_1302_1500
                    group by symbol, Date, interval(X=Tradetime, duration=5m, fill="none", closed="right", label="left") as Tradetime
    update bar_1302_1500 set Tradetime = temporalAdd(Tradetime, 1m)
    bar_1302_1500 = select symbol, concatDateTime(Date, Tradetime) as datetime, open, high, low, close, total_turnover, vwap5
                    from bar_1302_1500

    // 5. 合并该年的三个子集，计算 vwap_ret
    yearResult = select * from bar_0932_1126
                union all
                select * from bar_1127_1301
                union all
                select * from bar_1302_1500

    yearResult = select * from yearResult order by datetime, symbol
    yearResult = select symbol, datetime,
                open,
                close,
                total_turnover as turnover,
                vwap5,
                next(vwap5 / prev(vwap5) - 1) as vwap_ret
                from yearResult
                context by symbol csort datetime

    // 6. 将当年结果追加到最终结果表
    finalResult.append!(yearResult)

    print("Finished processing year: " + string(year))
}

// 7. 保存最终结果
parquet::saveParquet(finalResult, "/home/trq/update_daily/5min_bar_full_left_close.parquet")

print("All years processed and saved successfully.")

