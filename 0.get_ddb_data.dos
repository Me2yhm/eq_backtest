// undef all

go
START = 2019.01.01



// 获取日频数据
daily = select symbol, date, open, close, limit_up as limit_up_price, limit_down as limit_down_price, total_turnover as turnover from loadTable("dfs://stocks_daily", "bars_ex") where date >= START
// 获取市值排名
size = select trade_day as date, symbol, value as size , log(value) as log_size from loadTable("dfs://stocks_fundamental", "rq_fundamental") where field_name == 'market_cap_3' and value != NULL and trade_day >= START
size = select date, symbol, log_size, rank(size, false) as size_rank from size context by date order by date
// 获取行业数据
industry = select trade_day as date, symbol, value as industry from loadTable("dfs://stocks_daily", "stock_price_info") where field_name == 'citics_2019_first'
// 获取所需要指数的数据
indexComp = select trade_day as Date,index_symbol as index, component_symbol as Component from loadTable("dfs://stocks_daily", "index_component_weight") where index_symbol = "000300.XSHG" or index_symbol="000905.XSHG" or index_symbol = "000852.XSHG" or index_symbol = "932000.INDX"

// 给 daily 一个 每个月 1 号 的链接键
daily = select *, monthBegin(date) as monthDate from daily
// join行业
daily = lj(daily, industry, `symbol`date)
// join指数成分
daily = lj(daily, indexComp, `symbol`monthDate, `Component`Date)
update daily set index = "Others" where index is null
dropColumns!(daily, `monthDate)

// 增加市值排名列
daily = lj(daily, size, `symbol`date)
// 新增跌停状态
daily = select *, 
        open >= limit_up_price as is_limit_up, 
        open <= limit_down_price as is_limit_down, 
        next(open) / open - 1 as nd_ret from daily context by symbol csort date


daily = select symbol,date,turnover,log_size,size_rank,bfill!(ffill!(industry)) as industry,index,next(nd_ret) as ret, is_limit_up,is_limit_down from daily context by symbol csort date


def allValidCondition(daily,startDate,listedOver=20){
    // 上市超过x天
    listed = select * from loadTable("dfs://stocks_daily", "stock_listed_date")
    t = lj(select symbol, date from daily, listed, `symbol)
    listedStatus = select symbol, date, iif( date >= temporalAdd(listed_date, listedOver, "XSHE") and date <= delisted_date, 1, 0) as listed_Satisfied from t order by symbol, date
    // 当天是否为ST
    STStatus = select trade_day as date, symbol, value as is_ST from loadTable("dfs://stocks_daily", "stock_price_info") where field_name = 'is_st'
    // 查询停牌情况
    suspendStatus = select symbol, trade_day as date, int(value) as SuspendStatus from loadTable("dfs://stocks_daily", "stock_price_info") where field_name = 'is_suspend'
    // 每个 symbol 内按 date 顺序做累计 
    suspendStatus = select *, cumsum(SuspendStatus) as seg from suspendStatus context by symbol csort date
    suspendStatus = select *, cumsum(iif(SuspendStatus==0, 1, 0)) as normal_days from suspendStatus context by symbol, seg csort date
    suspendStatus = select symbol,date,normal_days from suspendStatus
    // 结果接回到daily
    result = lj(lj(lj(daily, listedStatus, `symbol`date),STStatus,`symbol`date),suspendStatus,`symbol`date)
    return result
}

daily = select * from allValidCondition(daily,START) where ret is not null

// saveText(daily, "save/daily.csv")
parquet::saveParquet(daily, "save/daily.pqt")
