undef all
go


// START = 2025.01.01
START = 2025.12.01


bar1Min = select symbol, datetime, open, high, low, close, total_turnover, volume, date(datetime) as Date,time(datetime) as Tradetime from loadTable("dfs://bars_1m", "stocks_ex")
    where date(datetime) >= START
// 09:31的数据不参与聚合，直接select
bar_0931 = select symbol, datetime, open, high, low, close, total_turnover, (open+high+low+close)/4 as vwap15 from bar1Min where Tradetime = 09:31:00.000
// 09:32-14:46的数据，聚合为15分钟频
bar_0932_1446 = select * from bar1Min where Tradetime between 09:32:00.000 and 14:46:00.000
update bar_0932_1446 set Tradetime = temporalAdd(Tradetime,-1m)
bar_0932_1446 = select firstNot(open) as open,last(close) as close, max(high) as high, min(low) as low, sum(total_turnover) as total_turnover,
    iif(sum(volume)>0, sum(volume * (open+high+low+close)/4) \ sum(volume), avg((open+high+low+close)/4)) as vwap15
    from bar_0932_1446 group by symbol,Date,interval(X=Tradetime,duration=15m,fill="none",closed="right",label="right") as Tradetime
update bar_0932_1446 set Tradetime = temporalAdd(Tradetime,1m)
bar_0932_1446 = select symbol, concatDateTime(Date, Tradetime) as datetime, open, high, low, close, total_turnover, vwap15 from bar_0932_1446
// 14:47-15:00的数据作为最后一条保留
bar_1447_1500 = select symbol, datetime, open, high, low, close, total_turnover, volume, Date, Tradetime from bar1Min where Tradetime between 14:47:00.000 and 15:00:00.000
bar_1447_1500 = select last(datetime) as datetime, firstNot(open) as open, max(high) as high, min(low) as low, last(close) as close, sum(total_turnover) as total_turnover,
    iif(sum(volume)>0, sum(volume * (open+high+low+close)/4) \ sum(volume), avg((open+high+low+close)/4)) as vwap15
    from bar_1447_1500 group by symbol,Date
bar_1447_1500 = select symbol, datetime, open, high, low, close, total_turnover, vwap15 from bar_1447_1500

result = select * from bar_0931
    union all
    select * from bar_0932_1446
    union all
    select * from bar_1447_1500
result = select * from result order by datetime, symbol
// result = select *, vwap15 / prev(vwap15) - 1 as vwap_ret from result context by symbol csort datetime


result = select symbol, datetime, 
        open,
        total_turnover as turnover,
        vwap15,
        next(vwap15 / prev(vwap15) - 1) as vwap_ret from result context by symbol csort datetime


